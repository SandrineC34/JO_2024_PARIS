body {
    background-color: #f8f9fa;
}

/* Page Header */
.page-header {
    background: linear-gradient(135deg, #004e92 0%, #009ffd 100%);
    color: white;
    text-align: center;
    padding: 60px 20px;
}

.page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 15px;
}

/* Main Content */
.main-content {
    padding: 40px 20px;
}

.cart-container {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
}

/* Cart Items */
.cart-items {
    background: white;
    border-radius: 10px;
    padding: 30px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

.cart-items h2 {
    color: #004e92;
    margin-bottom: 30px;
    font-size: 1.8rem;
}

.empty-cart {
    text-align: center;
    padding: 60px 20px;
    color: #666;
}

.empty-cart-icon {
    font-size: 4rem;
    margin-bottom: 20px;
    opacity: 0.5;
}

.cart-item {
    border: 2px solid #e9ecef;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 20px;
