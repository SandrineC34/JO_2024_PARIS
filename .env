# .env
# Fichier de configuration des variables d'environnement
# À placer à la RACINE du projet

# ============================================
# MySQL Configuration
# ============================================
MYSQL_ROOT_PASSWORD=RootPassword123!
MYSQL_DATABASE=jo2024_db
MYSQL_USER=jo2024_user
MYSQL_PASSWORD=JO2024Pass123!

# ============================================
