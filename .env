# -------------------------
# Configuration Email
#  - En DEV : on utilise MailHog (pas d'auth)
#  - En PROD : remplacer SMTP_HOST/PORT/USER/PASSWORD par les valeurs réelles
#    et stocker SMTP_PASSWORD dans un secret manager (ne pas commit dans Git).
# -------------------------
# Pour dev avec MailHog :
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Exemple production (NE PAS COMMITER) :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=ton.email@domaine.tld
# SMTP_PASSWORD=ton_mot_de_passe_ou_app_password

FROM_EMAIL=noreply@jo2024.local
