{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "AllowedHosts": "*",

  // ========================================================
  // 🐋 SECTION DOCKER LOCAL (MySQL)
  // --------------------------------------------------------
  // 👉 Active par défaut pour exécution locale (Docker Desktop)
  // ========================================================
  "ConnectionStrings": {
    "MySQLConnection": "server=mysql;port=3306;database=jo2024db;user=root;password=example;"
  },

  // ========================================================
  // ☁️ SECTION RENDER (PostgreSQL)
  // --------------------------------------------------------
  // 👉 Cette section n’est utilisée que si tu déploies sur Render.
  //    Elle peut être laissée telle quelle, car Render fournit
  //    automatiquement la variable d’environnement DATABASE_URL.
  // ========================================================
  "Render": {
    "DatabaseUrl": ""
  },

  // ========================================================
  // 🔐 CONFIGURATION JWT
  // --------------------------------------------------------
  // 👉 À personnaliser selon ta clé d’émission
  // ========================================================
  "Jwt": {
    "Key": "TaCléSuperSécuriséeÀChanger123!",
    "Issuer": "JO2024_API",
    "Audience": "JO2024_Clients",
    "DurationInMinutes": 60
  },

  // ========================================================
  // 📧 CONFIGURATION MAILKIT (exemple)
  // --------------------------------------------------------
  // 👉 Facultatif, selon si tu envoies des mails
  // ========================================================
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "JO2024 Support",
    "SenderEmail": "support@jo2024.com",
    "Username": "support@jo2024.com",
    "Password": "MotDePasseÀChanger",
    "UseSSL": false
  }
}
